@PACKAGE_INIT@

if(CMAKE_VERSION VERSION_LESS 3.24)
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "PGW requires CMake 3.24+ for Micro archive rescanning")
    return()
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@" OR
   NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@)
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "PGW requires its build-time target OS and pointer width")
    return()
endif()
if(NOT CMAKE_C_LINK_GROUP_USING_RESCAN_SUPPORTED AND NOT CMAKE_LINK_GROUP_USING_RESCAN_SUPPORTED)
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "PGW requires linker archive RESCAN support")
    return()
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)

set(PGW_CMAKE_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}/modules")
set(_pgw_saved_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${PGW_CMAKE_MODULE_DIR}")
if(NOT RTIMEHOME AND DEFINED ENV{RTIMEHOME})
    set(RTIMEHOME "$ENV{RTIMEHOME}" CACHE PATH "External licensed Connext Micro SDK root")
endif()
if(NOT RTIMEHOME)
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "Set RTIMEHOME to the external Connext Micro SDK root")
    set(CMAKE_MODULE_PATH "${_pgw_saved_module_path}")
    return()
endif()
if(NOT DEFINED RTIME_PIL_ARCH)
    set(RTIME_PIL_ARCH "@RTIME_PIL_ARCH@" CACHE STRING "PGW Micro PIL architecture")
endif()
if(NOT DEFINED RTIME_PSL_ARCH)
    set(RTIME_PSL_ARCH "@RTIME_PSL_ARCH@" CACHE STRING "PGW Micro PSL architecture")
endif()
if(NOT DEFINED RTIME_TARGET_NAME)
    set(RTIME_TARGET_NAME "@PGW_INSTALL_TARGET_NAME@" CACHE STRING "PGW Micro target architecture")
endif()
set(_pgw_archive_configuration "@PGW_INSTALL_MICRO_CONFIGURATION@")
set(_pgw_gateway_configuration "@PGW_INSTALL_CONFIGURATION@")
if(DEFINED RTIME_LIBS_BUILD_TYPE AND
   NOT RTIME_LIBS_BUILD_TYPE STREQUAL "Auto" AND
   NOT RTIME_LIBS_BUILD_TYPE STREQUAL _pgw_archive_configuration)
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE
        "This PGW installation requires Micro ${_pgw_archive_configuration} archives")
    set(CMAKE_MODULE_PATH "${_pgw_saved_module_path}")
    return()
endif()
if(TARGET RTIConnextMicroDDS::core AND RTIME_LIBS_BUILD_TYPE STREQUAL "Auto")
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "Find PGW before creating automatically configured Micro imported targets")
    set(CMAKE_MODULE_PATH "${_pgw_saved_module_path}")
    return()
endif()
set(RTIME_LIBS_BUILD_TYPE "${_pgw_archive_configuration}" CACHE STRING
    "Micro archive configuration matching the installed PGW package" FORCE)
if(NOT RTIME_PIL_ARCH STREQUAL "@RTIME_PIL_ARCH@" OR
   NOT RTIME_PSL_ARCH STREQUAL "@RTIME_PSL_ARCH@")
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "PGW requires its build-time Micro PIL/PSL architecture pair")
    set(CMAKE_MODULE_PATH "${_pgw_saved_module_path}")
    return()
endif()
file(REAL_PATH "${RTIMEHOME}" _pgw_requested_sdk)
set(_pgw_saved_runtime_only "${PGW_MICRO_RUNTIME_ONLY}")
set(_pgw_saved_shared_libs "${BUILD_SHARED_LIBS}")
set(_pgw_had_shared_libs FALSE)
set(_pgw_had_runtime_only FALSE)
if(DEFINED BUILD_SHARED_LIBS)
    set(_pgw_had_shared_libs TRUE)
endif()
if(DEFINED PGW_MICRO_RUNTIME_ONLY)
    set(_pgw_had_runtime_only TRUE)
endif()
set(PGW_MICRO_RUNTIME_ONLY TRUE)
set(BUILD_SHARED_LIBS OFF)
set(_pgw_rti_components "")
if("@PGW_ENABLE_DDS@")
    set(_pgw_rti_components c dpde appgen)
endif()
find_package(RTIConnextMicroDDS 4.3.0 QUIET COMPONENTS ${_pgw_rti_components})
if(_pgw_had_runtime_only)
    set(PGW_MICRO_RUNTIME_ONLY "${_pgw_saved_runtime_only}")
else()
    unset(PGW_MICRO_RUNTIME_ONLY)
endif()
if(_pgw_had_shared_libs)
    set(BUILD_SHARED_LIBS "${_pgw_saved_shared_libs}")
else()
    unset(BUILD_SHARED_LIBS)
endif()
set(CMAKE_MODULE_PATH "${_pgw_saved_module_path}")
if(NOT RTIConnextMicroDDS_FOUND)
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "PGW requires an external licensed Connext Micro 4.3.0 SDK")
    return()
endif()
file(REAL_PATH "${RTIMEHOME}" _pgw_found_sdk)
if(NOT RTIME_VERSION MATCHES "^4\\.3\\.0(\\.0)?$" OR
   NOT _pgw_found_sdk STREQUAL _pgw_requested_sdk OR
   NOT RTIME_PIL_ARCH STREQUAL "@RTIME_PIL_ARCH@" OR
   NOT RTIME_PSL_ARCH STREQUAL "@RTIME_PSL_ARCH@")
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "The external Micro SDK does not match the verified PGW SDK contract")
    return()
endif()
get_target_property(_pgw_rti_kind RTIConnextMicroDDS::core TYPE)
get_target_property(_pgw_rti_location RTIConnextMicroDDS::core IMPORTED_LOCATION)
file(REAL_PATH "${_pgw_rti_location}" _pgw_rti_location)
cmake_path(IS_PREFIX _pgw_requested_sdk "${_pgw_rti_location}" NORMALIZE _pgw_rti_in_sdk)
if(NOT _pgw_rti_kind STREQUAL "STATIC_LIBRARY" OR NOT _pgw_rti_in_sdk)
    set(PGW_FOUND FALSE)
    set(PGW_NOT_FOUND_MESSAGE "PGW cannot reuse incompatible pre-existing Micro imported targets")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PGWTargets.cmake")
foreach(_pgw_component IN ITEMS @PGW_INSTALLED_COMPONENTS@)
    set(PGW_${_pgw_component}_FOUND TRUE)
    # Bind consumers to the gateway archive variant installed by this package.
    set_target_properties(PGW::${_pgw_component} PROPERTIES
        MAP_IMPORTED_CONFIG_DEBUG "${_pgw_gateway_configuration}"
        MAP_IMPORTED_CONFIG_RELEASE "${_pgw_gateway_configuration}"
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO "${_pgw_gateway_configuration}"
        MAP_IMPORTED_CONFIG_MINSIZEREL "${_pgw_gateway_configuration}")
endforeach()
check_required_components(PGW)
