module PGW_Control {
    enum Action {
        CONNECTION_UP,
        CONNECTION_DOWN,
        INPUT_ENABLE,
        INPUT_DISABLE,
        OUTPUT_ENABLE,
        OUTPUT_DISABLE,
        ROUTE_PAUSE,
        ROUTE_RESUME
    };

    enum ResourceStatus {
        UNKNOWN,
        UP,
        DOWN,
        PAUSED,
        FAULTED
    };

    enum CommandOutcome {
        APPLIED,
        NO_CHANGE,
        UNSUPPORTED,
        INVALID,
        FAILED
    };

    enum TelemetryScalarType {
        BOOLEAN_VALUE,
        INT32_VALUE,
        UINT32_VALUE,
        INT64_VALUE,
        UINT64_VALUE,
        DOUBLE_VALUE
    };
};
