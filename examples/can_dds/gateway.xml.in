<gateway dds="dds.xml" sample-budget="8">
  <binding id="powertrain" symbol="PGW_signal_dds_binding_powertrain" type="PGW_DDS::Signal" schema="pgw.signal" fingerprint="@fingerprint@" schema-version="1" representation-name="signal.native" native-type="PGW_Signal" native-header="pgw/signal.h" support-header="signalsSupport.h" conversion="callbacks" dds-to-native="PGW_signal_from_dds" native-to-dds="PGW_signal_to_dds" register-keys="PGW_signal_register_keys_powertrain" supports-timestamp="true" direct-native-write="true" validate-native="PGW_signal_validate_dds" bind-view="PGW_signal_bind_view" write-view="PGW_signal_write_view"/>
  <binding id="auxiliary" symbol="PGW_signal_dds_binding_auxiliary" type="PGW_DDS::Signal" schema="pgw.signal" fingerprint="@fingerprint@" schema-version="1" representation-name="signal.native" native-type="PGW_Signal" native-header="pgw/signal.h" support-header="signalsSupport.h" conversion="callbacks" dds-to-native="PGW_signal_from_dds" native-to-dds="PGW_signal_to_dds" register-keys="PGW_signal_register_keys_auxiliary" supports-timestamp="true" direct-native-write="true" validate-native="PGW_signal_validate_dds" bind-view="PGW_signal_bind_view" write-view="PGW_signal_write_view"/>
  <binding id="probe" symbol="PGW_probe_binding" type="PGWTest::Probe" schema="pgw.probe" fingerprint="@probe_fingerprint@" schema-version="1" representation-name="probe.native" native-type="PGW_ProbeValue" native-header="probe_binding.h" support-header="probeSupport.h" conversion="fieldwise" register-key-value="1" supports-timestamp="true" direct-native-write="true"/>
  <binding id="diagnostics" symbol="PGW_diagnostics_binding" type="PGWManagement::Snapshot" schema="pgw.diagnostics" fingerprint="@diagnostics_fingerprint@" schema-version="1" representation-name="diagnostics.native" native-type="PGW_CounterSnapshot" native-header="pgw/diagnostics.h" support-header="diagnosticsSupport.h" conversion="callbacks" dds-to-native="PGW_diagnostics_from_dds" native-to-dds="PGW_diagnostics_to_dds" register-keys="PGW_diagnostics_register_keys" sample-copy="PGW_diagnostics_sample_copy"/>
  <connection id="gateway" participant="GatewayParticipants::Gateway" adapter="connext_micro">
    <stream name="state_powertrain" endpoint="Out::StatePowertrain" binding="powertrain" role="writer" capacity="8"/>
    <stream name="state_auxiliary" endpoint="Out::StateAuxiliary" binding="auxiliary" role="writer" capacity="8"/>
    <stream name="command_powertrain" endpoint="In::CommandPowertrain" binding="powertrain" role="reader" capacity="8"/>
    <stream name="command_auxiliary" endpoint="In::CommandAuxiliary" binding="auxiliary" role="reader" capacity="8"/>
    <stream name="probe" endpoint="Out::Probe" binding="probe" role="writer" capacity="1" preserve-source-timestamp="true"/>
    <stream name="diagnostics" endpoint="Out::Diagnostics" binding="diagnostics" role="writer" capacity="4"/>
  </connection>
  <connection id="companion" participant="GatewayParticipants::Companion" adapter="connext_micro">
    <stream name="state_powertrain" endpoint="In::StatePowertrain" binding="powertrain" role="reader" capacity="8"/>
    <stream name="state_auxiliary" endpoint="In::StateAuxiliary" binding="auxiliary" role="reader" capacity="8"/>
    <stream name="command_powertrain" endpoint="Out::CommandPowertrain" binding="powertrain" role="writer" capacity="8"/>
    <stream name="command_auxiliary" endpoint="Out::CommandAuxiliary" binding="auxiliary" role="writer" capacity="8"/>
    <stream name="probe" endpoint="In::Probe" binding="probe" role="reader" capacity="1"/>
    <stream name="diagnostics" endpoint="In::Diagnostics" binding="diagnostics" role="reader" capacity="4"/>
  </connection>
  <native-connection id="can" adapter="can" receive-budget="4" write-capacity="8">
    <stream name="state_powertrain" endpoint="powertrain" binding="powertrain" role="reader" capacity="8"/>
    <stream name="state_auxiliary" endpoint="auxiliary" binding="auxiliary" role="reader" capacity="8"/>
    <stream name="command_powertrain" endpoint="powertrain" binding="powertrain" role="writer" capacity="8"/>
    <stream name="command_auxiliary" endpoint="auxiliary" binding="auxiliary" role="writer" capacity="8"/>
  </native-connection>
  <session name="vehicle">
    <route id="state_powertrain" input="can::state_powertrain" output="gateway::state_powertrain"/>
    <route id="state_auxiliary" input="can::state_auxiliary" output="gateway::state_auxiliary"/>
    <route id="command_powertrain" input="gateway::command_powertrain" output="can::command_powertrain"/>
    <route id="command_auxiliary" input="gateway::command_auxiliary" output="can::command_auxiliary"/>
  </session>
</gateway>
