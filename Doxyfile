PROJECT_NAME           = "RTI Micro Protocol Gateway"
OUTPUT_DIRECTORY       = build/docs-source
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# These paths mirror the public-header install rules in cmake/PGWInstall.cmake.
INPUT                  = core/include/pgw \
                         adapters/can/include/pgw \
                         adapters/dds/connext_micro/include/pgw \
                         bindings/signal/include/pgw/signal.h \
                         docs/api-groups.dox
FILE_PATTERNS          = *.h *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       =
STRIP_FROM_PATH        = core/include adapters/can/include adapters/dds/connext_micro/include bindings/signal/include

OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = reference
GENERATE_LATEX          = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO
GENERATE_XML            = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = YES
HAVE_DOT                = NO
